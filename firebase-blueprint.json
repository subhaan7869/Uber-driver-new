{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated UK Uber Driver account profile, vehicle details, PHV licence, and Pro metrics (PII isolated to owner).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Driver full display name.",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified driver Google email address (PII, owner-only).",
          "minLength": 3,
          "maxLength": 120
        },
        "city": {
          "type": "string",
          "description": "Primary operating UK city.",
          "minLength": 1,
          "maxLength": 60
        },
        "tier": {
          "type": "string",
          "description": "Uber Pro loyalty tier.",
          "enum": ["Diamond", "Platinum", "Gold"],
          "maxLength": 20
        },
        "vehicle": {
          "type": "string",
          "description": "Registered vehicle make and model.",
          "minLength": 1,
          "maxLength": 80
        },
        "vehicleColor": {
          "type": "string",
          "description": "Registered vehicle colour.",
          "minLength": 1,
          "maxLength": 40
        },
        "licensePlate": {
          "type": "string",
          "description": "UK vehicle registration plate.",
          "minLength": 1,
          "maxLength": 20
        },
        "phvBadge": {
          "type": "string",
          "description": "UK Private Hire Vehicle badge number.",
          "minLength": 1,
          "maxLength": 32
        },
        "rating": {
          "type": "number",
          "description": "Current driver star rating (1.0 to 5.0)."
        },
        "proPoints": {
          "type": "number",
          "description": "Accumulated Uber Pro points."
        },
        "acceptanceRate": {
          "type": "number",
          "description": "Driver acceptance rate percentage (0-100)."
        },
        "cancellationRate": {
          "type": "number",
          "description": "Driver cancellation rate percentage (0-100)."
        },
        "drivingMinutesUsedToday": {
          "type": "number",
          "description": "UK regulatory driving minutes logged today."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-validated creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-validated last update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "city",
        "tier",
        "vehicle",
        "vehicleColor",
        "licensePlate",
        "phvBadge",
        "rating",
        "proPoints",
        "acceptanceRate",
        "cancellationRate",
        "drivingMinutesUsedToday",
        "createdAt",
        "updatedAt"
      ]
    },
    "DriverLedgerState": {
      "title": "DriverLedgerState",
      "description": "Driver wallet balance, daily earnings totals map, trip statistics counters, and synced driver preferences.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "walletBalance": {
          "type": "number",
          "description": "Current UK Sterling wallet balance."
        },
        "proPoints": {
          "type": "number",
          "description": "Synced Uber Pro points total."
        },
        "questCompletedCount": {
          "type": "number",
          "description": "Completed Quest trips in current cycle."
        },
        "totalReceived": {
          "type": "number",
          "description": "Total trip requests received."
        },
        "acceptedCount": {
          "type": "number",
          "description": "Total trip requests accepted."
        },
        "declinedCount": {
          "type": "number",
          "description": "Total trip requests declined."
        },
        "radarLostCount": {
          "type": "number",
          "description": "Total Trip Radar requests matched to another driver."
        },
        "dailyTotals": {
          "type": "object",
          "description": "Map of YYYY-MM-DD date keys to GBP daily earnings numbers."
        },
        "preferences": {
          "type": "object",
          "description": "Map of DriverPreferences toggles and navigation settings."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-validated creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-validated last update timestamp."
        }
      },
      "required": [
        "ownerUid",
        "walletBalance",
        "proPoints",
        "questCompletedCount",
        "totalReceived",
        "acceptedCount",
        "declinedCount",
        "radarLostCount",
        "dailyTotals",
        "preferences",
        "createdAt",
        "updatedAt"
      ]
    },
    "CompletedTripRecord": {
      "title": "CompletedTripRecord",
      "description": "Immutable ledger record for a completed or no-show trip.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tripId": {
          "type": "string",
          "description": "Trip record identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "riderName": {
          "type": "string",
          "description": "Rider first name or merchant label.",
          "minLength": 1,
          "maxLength": 80
        },
        "serviceName": {
          "type": "string",
          "description": "Service type such as UberX, Comfort, UberXL, Uber Pet, Uber Eats, or Intercity.",
          "minLength": 1,
          "maxLength": 40
        },
        "fare": {
          "type": "number",
          "description": "Base trip fare in GBP."
        },
        "tip": {
          "type": "number",
          "description": "Rider tip in GBP."
        },
        "waitFee": {
          "type": "number",
          "description": "Wait time surcharge in GBP."
        },
        "netPayout": {
          "type": "number",
          "description": "Net driver payout in GBP."
        },
        "distanceMiles": {
          "type": "number",
          "description": "Trip distance in UK miles."
        },
        "durationMin": {
          "type": "number",
          "description": "Trip duration in minutes."
        },
        "pickupArea": {
          "type": "string",
          "description": "Pickup locality label.",
          "minLength": 1,
          "maxLength": 100
        },
        "dropoffArea": {
          "type": "string",
          "description": "Dropoff locality label.",
          "minLength": 1,
          "maxLength": 100
        },
        "completedAtLabel": {
          "type": "string",
          "description": "Display time label (HH:mm).",
          "minLength": 1,
          "maxLength": 24
        },
        "dateKey": {
          "type": "string",
          "description": "Local YYYY-MM-DD key.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "isIntercity": {
          "type": "boolean",
          "description": "Whether the trip was an Intercity out-of-city ride."
        },
        "isNoShowFee": {
          "type": "boolean",
          "description": "Whether the payout was a rider no-show fee."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-validated creation timestamp."
        }
      },
      "required": [
        "ownerUid",
        "tripId",
        "riderName",
        "serviceName",
        "fare",
        "tip",
        "waitFee",
        "netPayout",
        "distanceMiles",
        "durationMin",
        "pickupArea",
        "dropoffArea",
        "completedAtLabel",
        "dateKey",
        "isIntercity",
        "isNoShowFee",
        "createdAt"
      ]
    },
    "TripActivityRecord": {
      "title": "TripActivityRecord",
      "description": "Immutable audit entry for an accepted, declined, or radar-lost job request.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "offerId": {
          "type": "string",
          "description": "Offer identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceName": {
          "type": "string",
          "description": "Service name for the offer.",
          "minLength": 1,
          "maxLength": 40
        },
        "offerType": {
          "type": "string",
          "description": "Dispatch channel type.",
          "enum": ["exclusive", "radar", "reserve", "queued"],
          "maxLength": 16
        },
        "status": {
          "type": "string",
          "description": "Driver resolution of the request.",
          "enum": ["accepted", "declined", "radar_lost"],
          "maxLength": 16
        },
        "fare": {
          "type": "number",
          "description": "Upfront fare offered in GBP."
        },
        "pickupArea": {
          "type": "string",
          "description": "Pickup locality label.",
          "minLength": 1,
          "maxLength": 100
        },
        "dropoffArea": {
          "type": "string",
          "description": "Dropoff locality label.",
          "minLength": 1,
          "maxLength": 100
        },
        "timestampLabel": {
          "type": "string",
          "description": "Formatted HH:mm timestamp label.",
          "minLength": 1,
          "maxLength": 24
        },
        "dateKey": {
          "type": "string",
          "description": "Local YYYY-MM-DD key.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-validated creation timestamp."
        }
      },
      "required": [
        "ownerUid",
        "offerId",
        "serviceName",
        "offerType",
        "status",
        "fare",
        "pickupArea",
        "dropoffArea",
        "timestampLabel",
        "dateKey",
        "createdAt"
      ]
    },
    "ReserveBookingRecord": {
      "title": "ReserveBookingRecord",
      "description": "Scheduled Uber Reserve booking synced across devices with terminal status locking.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reserveId": {
          "type": "string",
          "description": "Reserve slot identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "description": "Reserve trip category.",
          "enum": ["local", "airport", "executive"],
          "maxLength": 20
        },
        "serviceName": {
          "type": "string",
          "description": "Reserve tier label.",
          "minLength": 1,
          "maxLength": 40
        },
        "scheduledAtMs": {
          "type": "number",
          "description": "Epoch milliseconds for scheduled pickup."
        },
        "dayLabel": {
          "type": "string",
          "description": "Day label such as Today or Tomorrow.",
          "minLength": 1,
          "maxLength": 32
        },
        "timeLabel": {
          "type": "string",
          "description": "Formatted pickup time.",
          "minLength": 1,
          "maxLength": 16
        },
        "onlineByLabel": {
          "type": "string",
          "description": "Required online-by time.",
          "minLength": 1,
          "maxLength": 16
        },
        "estimatedFare": {
          "type": "number",
          "description": "Estimated Reserve fare in GBP."
        },
        "reserveFee": {
          "type": "number",
          "description": "Reserve booking bonus fee in GBP."
        },
        "riderName": {
          "type": "string",
          "description": "Rider name.",
          "minLength": 1,
          "maxLength": 80
        },
        "pickupAddress": {
          "type": "string",
          "description": "Pickup street address.",
          "minLength": 1,
          "maxLength": 120
        },
        "pickupArea": {
          "type": "string",
          "description": "Pickup area label.",
          "minLength": 1,
          "maxLength": 100
        },
        "dropoffAddress": {
          "type": "string",
          "description": "Dropoff street address.",
          "minLength": 1,
          "maxLength": 120
        },
        "dropoffArea": {
          "type": "string",
          "description": "Dropoff area label.",
          "minLength": 1,
          "maxLength": 100
        },
        "tripMiles": {
          "type": "number",
          "description": "Estimated trip miles."
        },
        "tripMinutes": {
          "type": "number",
          "description": "Estimated trip minutes."
        },
        "pickupLat": {
          "type": "number",
          "description": "Pickup latitude."
        },
        "pickupLng": {
          "type": "number",
          "description": "Pickup longitude."
        },
        "dropoffLat": {
          "type": "number",
          "description": "Dropoff latitude."
        },
        "dropoffLng": {
          "type": "number",
          "description": "Dropoff longitude."
        },
        "status": {
          "type": "string",
          "description": "Reserve lifecycle state (completed/cancelled are terminal).",
          "enum": ["scheduled", "completed", "cancelled"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-validated creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server-validated update timestamp."
        }
      },
      "required": [
        "ownerUid",
        "reserveId",
        "category",
        "serviceName",
        "scheduledAtMs",
        "dayLabel",
        "timeLabel",
        "onlineByLabel",
        "estimatedFare",
        "reserveFee",
        "riderName",
        "pickupAddress",
        "pickupArea",
        "dropoffAddress",
        "dropoffArea",
        "tripMiles",
        "tripMinutes",
        "pickupLat",
        "pickupLng",
        "dropoffLat",
        "dropoffLng",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Owner-isolated driver account profile and vehicle/PHV credentials."
    },
    "/users/{userId}/state/{stateId}": {
      "schema": {
        "$ref": "#/entities/DriverLedgerState"
      },
      "description": "Owner-isolated driver ledger state (wallet, daily totals, trip stats, and preferences)."
    },
    "/users/{userId}/trips/{tripId}": {
      "schema": {
        "$ref": "#/entities/CompletedTripRecord"
      },
      "description": "Owner-isolated immutable completed trip records."
    },
    "/users/{userId}/activity/{activityId}": {
      "schema": {
        "$ref": "#/entities/TripActivityRecord"
      },
      "description": "Owner-isolated immutable trip offer activity records (received/accepted/declined/radar_lost)."
    },
    "/users/{userId}/reserves/{reserveId}": {
      "schema": {
        "$ref": "#/entities/ReserveBookingRecord"
      },
      "description": "Owner-isolated scheduled Uber Reserve bookings with terminal state locking."
    }
  }
}
